{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stopjuegodepalabras.com/schemas/linguistic-source-manifest.schema.json",
  "title": "STOP linguistic source manifest",
  "description": "Provenance and file-level licensing gate for external lexical datasets. Schema definition only; it does not approve or include any dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleVersion", "sources"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 2 },
    "bundleVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}([+-][A-Za-z0-9.-]+)?$"
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxId", "licenseTextPath", "appliesTo"],
      "properties": {
        "spdxId": { "type": "string", "minLength": 1 },
        "licenseTextPath": { "type": "string", "minLength": 1 },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "language", "locales", "upstreamUrl", "version",
        "revision", "sha256", "files", "licenses", "notices",
        "commercialUse", "modification", "redistribution",
        "shareAlike", "thirdPartyContent", "reviewStatus"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
        "language": { "enum": ["es", "en", "pt", "fr"] },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" }
        },
        "upstreamUrl": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 7 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/license" }
        },
        "notices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "commercialUse": { "type": "boolean" },
        "modification": { "type": "boolean" },
        "redistribution": { "type": "boolean" },
        "shareAlike": { "type": "boolean" },
        "thirdPartyContent": { "enum": ["none-known", "present-audited", "present-unaudited", "unknown"] },
        "reviewStatus": { "enum": ["candidate", "blocked", "approved"] },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "approvalReference": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "reviewStatus": { "const": "approved" } }, "required": ["reviewStatus"] },
          "then": {
            "required": ["reviewedBy", "reviewedAt", "approvalReference"],
            "properties": {
              "commercialUse": { "const": true },
              "redistribution": { "const": true },
              "thirdPartyContent": { "enum": ["none-known", "present-audited"] }
            }
          }
        }
      ]
    }
  }
}
