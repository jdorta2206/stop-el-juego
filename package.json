{
  "name": "stop-el-juego-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @workspace/stop-game dev",
    "build": "pnpm run build:railway",
    "build:railway": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/stop-game build",
    "start:railway": "node artifacts/api-server/dist/index.cjs",
    "lint": "pnpm --filter @workspace/stop-game lint",
    "typecheck": "pnpm --filter @workspace/api-server typecheck",
    "test": "pnpm --filter @workspace/api-server test",
    "preview": "pnpm --filter @workspace/stop-game preview"
  },
  "packageManager": "pnpm@10.15.1"
}
