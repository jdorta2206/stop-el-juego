{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node artifacts/api-server/dist/index.cjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "watchPatterns": [
    "/artifacts/api-server/**",
    "/artifacts/stop-game/**",
    "/Dockerfile",
    "/railway.json",
    "/package.json",
    "/pnpm-workspace.yaml"
  ]
}
